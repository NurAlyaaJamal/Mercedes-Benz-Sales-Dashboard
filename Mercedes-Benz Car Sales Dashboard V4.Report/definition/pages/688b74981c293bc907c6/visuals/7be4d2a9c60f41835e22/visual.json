                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  2023 was the peak: $242.9B revenue on 2.3M units. 2025 is down 5.5% on 2024 ($216.7B vs $229.4B).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
