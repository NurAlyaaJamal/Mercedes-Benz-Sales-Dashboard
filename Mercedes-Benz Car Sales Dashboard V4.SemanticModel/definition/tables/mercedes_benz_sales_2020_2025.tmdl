table mercedes_benz_sales_2020_2025
	lineageTag: dcc88097-416c-4cf9-84ef-fb0105449350

	measure 'Total Units' = SUM(mercedes_benz_sales_2020_2025[Sales Volume])
		formatString: 0
		lineageTag: bb24b003-5097-4941-826d-cc8e26fb6330

	measure 'Total Revenue' = SUM(mercedes_benz_sales_2020_2025[Revenue])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a39b0634-e288-4847-8857-ea65fa3300a7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average Price' = DIVIDE([Total Revenue],[Total Units])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 04e36c92-d09b-4123-ae1c-4ee7b4fdd06b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average Horsepower' = AVERAGE(mercedes_benz_sales_2020_2025[Horsepower])
		formatString: 0" hp"
		lineageTag: cfcef9a6-effd-47a9-928f-2b7fe14c1bb6

	measure 'Turbo %' = DIVIDE(CALCULATE([Total Units], mercedes_benz_sales_2020_2025[Turbo] = "Yes"),[Total Units])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 087aab74-698a-44ed-9cf6-4ae20b71fe32

	measure 'Revenue YoY Label' = VAR CurrYear = MAX(mercedes_benz_sales_2020_2025[Year]) VAR CurrVal = CALCULATE([Total Revenue], REMOVEFILTERS(mercedes_benz_sales_2020_2025[Year]), mercedes_benz_sales_2020_2025[Year] = CurrYear) VAR PrevVal = CALCULATE([Total Revenue], REMOVEFILTERS(mercedes_benz_sales_2020_2025[Year]), mercedes_benz_sales_2020_2025[Year] = CurrYear - 1) VAR Chg = DIVIDE(CurrVal - PrevVal, PrevVal) RETURN IF(ISBLANK(Chg), "", IF(Chg >= 0, "▲ ", "▼ ") & FORMAT(ABS(Chg), "0.0%") & " vs " & (CurrYear - 1))
		lineageTag: 5a1e7c42-3b9d-4f60-8c11-2d7e9a0b6f31

	measure 'Units YoY Label' = VAR CurrYear = MAX(mercedes_benz_sales_2020_2025[Year]) VAR CurrVal = CALCULATE([Total Units], REMOVEFILTERS(mercedes_benz_sales_2020_2025[Year]), mercedes_benz_sales_2020_2025[Year] = CurrYear) VAR PrevVal = CALCULATE([Total Units], REMOVEFILTERS(mercedes_benz_sales_2020_2025[Year]), mercedes_benz_sales_2020_2025[Year] = CurrYear - 1) VAR Chg = DIVIDE(CurrVal - PrevVal, PrevVal) RETURN IF(ISBLANK(Chg), "", IF(Chg >= 0, "▲ ", "▼ ") & FORMAT(ABS(Chg), "0.0%") & " vs " & (CurrYear - 1))
		lineageTag: c83d2f19-6e40-4b7a-9d52-1a4b8e7c3f20

	measure 'Revenue YoY Color' = VAR CurrYear = MAX(mercedes_benz_sales_2020_2025[Year]) VAR CurrVal = CALCULATE([Total Revenue], REMOVEFILTERS(mercedes_benz_sales_2020_2025[Year]), mercedes_benz_sales_2020_2025[Year] = CurrYear) VAR PrevVal = CALCULATE([Total Revenue], REMOVEFILTERS(mercedes_benz_sales_2020_2025[Year]), mercedes_benz_sales_2020_2025[Year] = CurrYear - 1) VAR Chg = DIVIDE(CurrVal - PrevVal, PrevVal) RETURN IF(ISBLANK(Chg), "#9AA4AE", IF(Chg >= 0, "#2DD4BF", "#F87171"))
		lineageTag: e4b7a1d2-5c30-4a8e-b6f9-0d1c2a3b4e51

	measure 'Units YoY Color' = VAR CurrYear = MAX(mercedes_benz_sales_2020_2025[Year]) VAR CurrVal = CALCULATE([Total Units], REMOVEFILTERS(mercedes_benz_sales_2020_2025[Year]), mercedes_benz_sales_2020_2025[Year] = CurrYear) VAR PrevVal = CALCULATE([Total Units], REMOVEFILTERS(mercedes_benz_sales_2020_2025[Year]), mercedes_benz_sales_2020_2025[Year] = CurrYear - 1) VAR Chg = DIVIDE(CurrVal - PrevVal, PrevVal) RETURN IF(ISBLANK(Chg), "#9AA4AE", IF(Chg >= 0, "#2DD4BF", "#F87171"))
		lineageTag: f5c8b2e3-6d41-4b9f-87a0-1e2d3b4c5f62

